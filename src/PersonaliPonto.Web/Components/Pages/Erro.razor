@page "/erro"
@layout LayoutLimpo
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
<PageTitle>Erro — PersonaliPonto</PageTitle>
<div style="min-height:100vh;display:grid;place-items:center;padding:16px">
    <div class="card card-corpo center" style="max-width:480px">
        <img src="img/logo.png" alt="PersonaliPonto" style="width:180px" />
        <h1 style="margin:16px 0 8px">Algo deu errado</h1>
        <p>Ocorreu um erro inesperado. A equipe foi notificada. Tente novamente em instantes.</p>
        <a class="btn btn-primario mt" href="/">Voltar</a>
    </div>
</div>
