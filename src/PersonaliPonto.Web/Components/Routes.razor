<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NaoEncontrado)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirecionarLogin />
                }
                else
                {
                    <PersonaliPonto.Web.Components.Pages.AcessoNegado />
                }
            </NotAuthorized>
            <Authorizing>
                <div class="carregando"><span class="spinner"></span> Carregando...</div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
