@* Barras empilhadas simples em SVG (sem dependências). *@
@if (Pontos.Count == 0)
{
    <Vazio Texto="Sem dados no período." Icone="relatorio" />
}
else
{
    var max = Math.Max(1, Pontos.Max(p => p.Valores.Sum()));
    var w = 100.0 / Pontos.Count;
    var passo = Math.Max(1, Pontos.Count / 10);
    <svg class="grafico" viewBox="0 0 100 60" preserveAspectRatio="none" role="img" aria-label="@Titulo">
        @for (var g = 1; g <= 3; g++)
        {
            var yg = 55 - g * 16.6;
            <line x1="0" x2="100" y1="@yg.ToString(System.Globalization.CultureInfo.InvariantCulture)" y2="@yg.ToString(System.Globalization.CultureInfo.InvariantCulture)" stroke="#dbe6f0" stroke-width="0.15" />
        }
        @for (var i = 0; i < Pontos.Count; i++)
        {
            var p = Pontos[i];
            var y = 55.0;
            for (var s = 0; s < p.Valores.Length; s++)
            {
                var h = 50.0 * p.Valores[s] / max;
                y -= h;
                var x = i * w + w * 0.18;
                <rect x="@x.ToString(System.Globalization.CultureInfo.InvariantCulture)" y="@y.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                      width="@((w * 0.64).ToString(System.Globalization.CultureInfo.InvariantCulture))" height="@h.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                      rx="0.4" fill="@Cores[s % Cores.Length]"><title>@p.Rotulo: @Formatar(p.Valores[s])</title></rect>
            }
            if (i % passo == 0)
            {
                var xt = i * w + w / 2;
                @((MarkupString)$"<text x=\"{xt.ToString(System.Globalization.CultureInfo.InvariantCulture)}\" y=\"59.5\" font-size=\"2.4\" text-anchor=\"middle\" fill=\"#94a3b8\">{System.Net.WebUtility.HtmlEncode(p.Rotulo)}</text>")
            }
        }
    </svg>
    <div class="legenda">
        @for (var s = 0; s < Series.Length; s++)
        {
            <span><i style="background:@Cores[s % Cores.Length]"></i>@Series[s]</span>
        }
    </div>
}

@code {
    public sealed record Ponto(string Rotulo, double[] Valores);
    [Parameter] public List<Ponto> Pontos { get; set; } = [];
    [Parameter] public string[] Series { get; set; } = [];
    [Parameter] public string[] Cores { get; set; } = ["#1166d6", "#21b8ef", "#c0392b"];
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public Func<double, string> Formatar { get; set; } = v => v.ToString("0");
}
