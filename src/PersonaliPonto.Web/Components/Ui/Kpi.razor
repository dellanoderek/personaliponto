<div class="card kpi @Estado">
    <span class="rotulo">@Rotulo</span>
    <span class="valor">@Valor</span>
    @if (!string.IsNullOrEmpty(Detalhe))
    {
        <span class="detalhe">@Detalhe</span>
    }
</div>

@code {
    [Parameter] public string Rotulo { get; set; } = "";
    [Parameter] public string Valor { get; set; } = "";
    [Parameter] public string? Detalhe { get; set; }
    [Parameter] public string? Estado { get; set; }
}
