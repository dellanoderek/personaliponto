@if (Aberto)
{
    <div class="modal-fundo" @onclick="FecharFundo">
        <div class="modal @(Grande ? "grande" : "")" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="modal-cab">
                <h2>@Titulo</h2>
                <button class="fechar" aria-label="Fechar" @onclick="Fechar">&times;</button>
            </div>
            <div class="modal-corpo">@ChildContent</div>
            @if (Rodape is not null)
            {
                <div class="modal-rodape">@Rodape</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Aberto { get; set; }
    [Parameter] public EventCallback<bool> AbertoChanged { get; set; }
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public bool Grande { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Rodape { get; set; }

    private Task Fechar() => AbertoChanged.InvokeAsync(false);
    private Task FecharFundo() => Fechar();
}
